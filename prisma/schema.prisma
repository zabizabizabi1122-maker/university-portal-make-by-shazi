datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

enum AssignmentSubmissionStatus {
  SUBMITTED
  GRADED
  LATE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(STUDENT)
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  announcements  Announcement[]
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Fall 2026", "Spring 2027"
  isCurrent Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  timetables Timetable[]
  feeInvoices FeeInvoice[]
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  courses  Course[]
  students StudentProfile[]
  faculty  FacultyProfile[]
}

model StudentProfile {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber   String      @unique
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  semester     Int         @default(1)
  cgpa         Float       @default(0.0)
  createdAt    DateTime    @default(now())

  enrollments   Enrollment[]
  attendance    Attendance[]
  submissions   Submission[]
  feeInvoices   FeeInvoice[]
}

model FacultyProfile {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation  String
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  courses    Course[]
  timetables Timetable[]
}

model Course {
  id           String          @id @default(cuid())
  code         String          @unique
  title        String
  credits      Int             @default(3)
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id])
  facultyId    String?
  faculty      FacultyProfile? @relation(fields: [facultyId], references: [id])
  createdAt    DateTime        @default(now())

  enrollments  Enrollment[]
  attendance   Attendance[]
  assignments  Assignment[]
  timetables   Timetable[]
}

model Enrollment {
  id        String         @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grade     String?        // e.g. "A", "B+", "F"
  marks     Float?         // numeric marks e.g. 88.5
  createdAt DateTime       @default(now())

  @@unique([studentId, courseId])
}

model Attendance {
  id        String           @id @default(cuid())
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now())

  @@unique([courseId, studentId, date])
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  dueDate     DateTime
  maxMarks    Float    @default(100.0)
  createdAt   DateTime @default(now())

  submissions Submission[]
}

model Submission {
  id           String                     @id @default(cuid())
  assignmentId String
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String                     @db.Text
  status       AssignmentSubmissionStatus @default(SUBMITTED)
  marks        Float?
  feedback     String?
  submittedAt  DateTime                   @default(now())

  @@unique([assignmentId, studentId])
}

model Timetable {
  id          String          @id @default(cuid())
  courseId    String
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyId   String?
  faculty     FacultyProfile? @relation(fields: [facultyId], references: [id])
  sessionId   String?
  session     AcademicSession? @relation(fields: [sessionId], references: [id])
  dayOfWeek   String          // Monday, Tuesday, Wednesday, Thursday, Friday
  startTime   String          // e.g. "09:00 AM"
  endTime     String          // e.g. "10:30 AM"
  room        String          // e.g. "Lab 3" or "Room 204"
  createdAt   DateTime        @default(now())
}

model FeeInvoice {
  id          String           @id @default(cuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     AcademicSession? @relation(fields: [sessionId], references: [id])
  title       String           // e.g. "Fall 2026 Tuition Fee"
  amount      Float
  dueDate     DateTime
  status      FeeStatus        @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  target    String   @default("ALL") // "ALL", "STUDENT", "FACULTY"
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}
